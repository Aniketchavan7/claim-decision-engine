  "cards": [
    {
      "dot": "cyan",
      "title": "Multi-Agent Orchestration & State Flow",
      "items": [
        "Orchestrated via LangGraph StateGraph with typed Pydantic v2 state schemas.",
        "Case Analysis Agent normalizes facts and plans dimensions without policy conclusions.",
        "Coverage & Exclusion Agent reasons over retrieved clauses regarding waiting periods and limits.",
        "Decision Agent aggregates findings and computes an observable non-probabilistic confidence score."
      ]
    },
    {
      "dot": "rose",
      "title": "Strict Abstention & Validation Gate",
      "items": [
        "Validation Agent gates every decision, auditing citation chunk IDs against actual policy text.",
        "Unsupported claims trigger a bounded feedback retry loop (max 2 retries).",
        "Strict IRDAI compliance: unverified hospital registration or bed count < 10 forces NEEDS_REVIEW."
      ]
    },
    {
      "dot": "emerald",
      "title": "Dimension-Specific Hybrid RAG",
      "items": [
        "Parallel dimension passes prevent broad cover clauses from masking specific exclusions.",
        "Dense retrieval (bge-small-en-v1.5) and sparse BM25s combined using Reciprocal Rank Fusion (k=60).",
        "Cross-encoder ms-marco-MiniLM-L-6-v2 reranks the top candidate passages per dimension."
      ]
    },
    {
      "dot": "amber",
      "title": "External Dependencies & Trust Boundaries",
      "items": [
        "Third-party LLM APIs (xKiro, Qwen, DeepSeek) are accessed via OpenAI-compatible SDK.",
        "Local FAISS and BM25 index stores preserve zero-leakage offline policy persistence.",
        "Streamlit UI interacts strictly over the public REST API boundary via /analyze."
      ]
    }
  ]
