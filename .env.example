# LLM Provider (xkiro, openai, groq, gemini)
LLM_PROVIDER=xkiro
LLM_API_KEY=your-api-key-here

# Models
LLM_REASONING_MODEL=qwen/qwen3.8-max:free
LLM_FAST_MODEL=qwen/qwen3.7-flash:free
LLM_FALLBACK_MODEL=minimax/minimax-m3:free

# Temperature
LLM_TEMPERATURE=0.1

# Embedding (local, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranker (local, no API key needed)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Paths
POLICY_PDF_PATH=policy/USGIC-CSCIndividualHealthInsurance_2017-2018.pdf
INDEX_DIR=data/index
